# App
APP_NAME=ReadingPal
ASPNETCORE_ENVIRONMENT=Development
NODE_ENV=development

# Frontend
FRONTEND_PORT=3000

# Service ports
USER_SERVICE_PORT=5000
INVENTORY_SERVICE_PORT=5001
LENDING_SERVICE_PORT=5002
NOTIFICATION_SERVICE_PORT=5003

# Service names
USER_SERVICE_NAME=user-service
INVENTORY_SERVICE_NAME=inventory-service
LENDING_SERVICE_NAME=lending-service
NOTIFICATION_SERVICE_NAME=notification-service

# MySQL
MYSQL_DATABASE=ReadingPal_auth
MYSQL_USER=readingpal_user
MYSQL_PASSWORD=readingpal_password
MYSQL_ROOT_PASSWORD=readingpal_root_password
MYSQL_PORT=3306

# Per-service database names
USER_DB_NAME=ReadingPal_auth
INVENTORY_DB_NAME=ReadingPal_inventory
LENDING_DB_NAME=ReadingPal_lending
NOTIFICATION_DB_NAME=ReadingPal_notification

# Kafka and ZooKeeper
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka topics
BOOK_ISSUED_TOPIC=book-issued
BOOK_RETURNED_TOPIC=book-returned
BOOK_OVERDUE_TOPIC=book-overdue

# JWT placeholders
JWT_ISSUER=ReadingPal
JWT_AUDIENCE=ReadingPal
JWT_SECRET=replace-with-a-secure-local-development-secret
