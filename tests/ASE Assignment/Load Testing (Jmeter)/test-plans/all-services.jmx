          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SETUP | Allocate isolated fixture" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
 def data=new groovy.json.JsonSlurper().parse(new File(props.get('accounts.file')))
 def row=data.accounts[Integer.parseInt(props.getProperty('customer.users','20'))+8+ctx.getThreadNum()]
 row.each { k,v -&gt; vars.put(k.toString(),v.toString()) }
 if(props.get('secrets.file')) {
  def secrets=new groovy.json.JsonSlurper().parse(new File(props.get('secrets.file')))
  vars.put('adminEmail', secrets.adminEmail ?: ''); vars.put('adminPassword', secrets.adminPassword ?: '')
 }
 ['searchTerm','genre','authorName'].each { k -&gt; vars.put(k+'Encoded',java.net.URLEncoder.encode(vars.get(k) ?: '', 'UTF-8')) }
} catch(Throwable e) { SampleResult.setSuccessful(false); SampleResult.setResponseMessage('Missing/invalid local fixture'); SampleResult.setStopThread(true) }</stringProp>
          </JSR223Sampler>
