          <stringProp name="script">def key='ase-'+UUID.randomUUID().toString().replace('-','').substring(0,16); vars.put('key',key); vars.put('newEmail',key+'@example.test'); vars.put('newPassword',UUID.randomUUID().toString()+'aA!1')</stringProp>
        </JSR223Sampler>
