              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
assert prev.getResponseCode() == '200' : 'Expected HTTP 200; got '+prev.getResponseCode()
def j = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
assert j.token; assert j.role == 'Admin'
vars.put('adminToken',j.token)
} catch(Throwable e) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Contract failed: '+e.getClass().getSimpleName()); if(true) prev.setStopThread(true) }</stringProp>
            </JSR223Assertion>
