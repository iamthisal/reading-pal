{
  "stryker-config": {
    "project": "LendingService.csproj",
    "test-projects": [
      "../../../unit-tests/LendingService.Tests/LendingService.Tests.csproj"
    ],
    "configuration": "Release",
    "mutation-level": "Standard",
    "mutate": [
      "**/*.cs",
      "!**/Migrations/**/*.cs",
      "!**/Program.cs"
    ],
    "ignore-methods": [
      "LogTrace",
      "LogDebug",
      "LogInformation",
      "LogWarning",
      "LogError",
      "LogCritical"
    ],
    "reporters": [
      "Progress",
      "ClearText",
      "Html",
      "Json"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    }
  }
}
