<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Lending Service Load Test" enabled="true">
      <stringProp name="TestPlan.comments">Load test for services/lending-service. Covers: POST /api/reservations, POST /api/reservations/{id}/accept, GET /api/my-borrowings, GET /api/reservations/pending. Every endpoint requires a JWT bearer token, acquired once in the setUp Thread Group and shared via JMeter properties. Run: jmeter -n -t tests/lending-load-test.jmx -l tests/jmeter-results/results.jtl -e -o tests/jmeter-results/report. Override any User Defined Variable with -J, e.g. -JTHREADS=50. Response Assertions verify each sampler returns the status code its controller action actually returns (see services/lending-service/Controllers). The Accept sampler under TG2 accepts 200, 409, or 503 as passing, since TG2 deliberately runs concurrent admin threads racing to accept the same reservation - 409/503 there is the optimistic-concurrency check working correctly, not a bug.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="LENDING_HOST" elementType="Argument">
            <stringProp name="Argument.name">LENDING_HOST</stringProp>
            <stringProp name="Argument.value">${__P(LENDING_HOST,localhost)}</stringProp>
          </elementProp>
          <elementProp name="LENDING_PORT" elementType="Argument">
            <stringProp name="Argument.name">LENDING_PORT</stringProp>
            <stringProp name="Argument.value">${__P(LENDING_PORT,5148)}</stringProp>
          </elementProp>
          <elementProp name="USER_HOST" elementType="Argument">
            <stringProp name="Argument.name">USER_HOST</stringProp>
            <stringProp name="Argument.value">${__P(USER_HOST,localhost)}</stringProp>
          </elementProp>
          <elementProp name="USER_PORT" elementType="Argument">
            <stringProp name="Argument.name">USER_PORT</stringProp>
            <stringProp name="Argument.value">${__P(USER_PORT,5000)}</stringProp>
          </elementProp>
          <elementProp name="THREADS" elementType="Argument">
            <stringProp name="Argument.name">THREADS</stringProp>
            <stringProp name="Argument.value">${__P(THREADS,10)}</stringProp>
          </elementProp>
          <elementProp name="RAMPUP" elementType="Argument">
            <stringProp name="Argument.name">RAMPUP</stringProp>
            <stringProp name="Argument.value">${__P(RAMPUP,10)}</stringProp>
          </elementProp>
          <elementProp name="LOOPS" elementType="Argument">
            <stringProp name="Argument.name">LOOPS</stringProp>
            <stringProp name="Argument.value">${__P(LOOPS,20)}</stringProp>
          </elementProp>
          <elementProp name="BOOK_ID" elementType="Argument">
            <stringProp name="Argument.name">BOOK_ID</stringProp>
            <stringProp name="Argument.value">${__P(BOOK_ID,1)}</stringProp>
          </elementProp>
          <elementProp name="ADMIN_EMAIL" elementType="Argument">
            <stringProp name="Argument.name">ADMIN_EMAIL</stringProp>
            <stringProp name="Argument.value">${__P(ADMIN_EMAIL,admin@library.com)}</stringProp>
          </elementProp>
          <elementProp name="ADMIN_PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">ADMIN_PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(ADMIN_PASSWORD,adminpassword)}</stringProp>
          </elementProp>
          <elementProp name="TEST_USER_EMAIL" elementType="Argument">
            <stringProp name="Argument.name">TEST_USER_EMAIL</stringProp>
            <stringProp name="Argument.value">${__P(TEST_USER_EMAIL,)}</stringProp>
          </elementProp>
          <elementProp name="TEST_USER_PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">TEST_USER_PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(TEST_USER_PASSWORD,)}</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
