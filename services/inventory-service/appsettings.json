{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=ReadingPal_inventory;Uid=root;Pwd=root;"
  },
  "Jwt": {
    "Key": "ThisIsAVerySecretKeyThatShouldBeStoredSecurelyAndLongEnough",
    "Issuer": "ReadingPal.UserService",
    "Audience": "ReadingPal.Frontend"
  },
  "Frontend": {
    "Url": "http://localhost:5173"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "SecurityProtocol": "Plaintext",
    "Topics": {
      "BookCreated": "book-created",
      "BookUpdated": "book-updated",
      "BookDeleted": "book-deleted"
    }
  }
}
