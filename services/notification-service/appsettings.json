{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=mysql;Port=3306;Database=ReadingPal_notification;Uid=root;Pwd=root;"
  },
  "InventoryService": {
    "BaseUrl": "http://inventory-service:8080"
  },
  "UserService": {
    "BaseUrl": "http://user-service:8080"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "SecurityProtocol": "Plaintext",
    "GroupId": "notification-service",
    "Topics": {
      "ReservationCreated": "reservation-created",
      "ReservationAccepted": "reservation-accepted",
      "ReservationCancelled": "reservation-cancelled",
      "BookReturned": "book-returned",
      "FineRecorded": "fine-recorded"
    }
  },
  "Frontend": {
    "Url": "http://localhost:5173"
  }
}
